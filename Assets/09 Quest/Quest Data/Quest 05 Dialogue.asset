  m_Script: {fileID: 11500000, guid: 08cda962ed693fe4cb309255159f3173, type: 3}
  m_Name: Quest 05 Dialogue
  m_EditorClassIdentifier: 
  dialogueId: Quest 05 Dialogue
  lines:
  - "\uB9C8\uCE68 \uC798 \uC654\uB124.\n\uC548 \uADF8\uB798\uB3C4 \uC54C\uB824\uC904\uAC8C
    \uC788\uC5C8\uB358 \uCC38\uC774\uC5C8\uB294\uB370."
  - "\uC369\uC740 \uC0B4\uC810\uC744 \uC880 \uC870\uC0AC\uD574 \uBCF4\uB2C8\n\uC4F8\uB9CC\uD55C
    \uAD6C\uC11D\uC774 \uC788\uB354\uB77C\uACE0."
  - "\uC790\uB124 \uACF5\uACA9\uB825, \uCCB4\uB825, \uD68C\uBCF5\uB7C9\uC744\n\uC5C5\uADF8\uB808\uC774\uB4DC\uD560
    \uC218 \uC788\uAC8C \uB9C8\uB828\uD574\uB1A8\uB124."
  - "\uD639\uC2DC \uC67C\uCABD \uAC74\uBB3C\uC5D0 \uC788\uB358 \uC0AC\uB78C \uBCF4\uC558\uB098?"
  - "\uADF8 \uC0AC\uB78C\uC774 \uC790\uB124 \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
    \uB3C4\uC640\uC904\uAC78\uC138."
  - "\uCC3E\uC544\uAC00\uC11C \uACF5\uACA9\uB825 \uC5C5\uADF8\uB808\uC774\uB4DC \uD55C\uBC88
    \uD574\uBCF4\uAC8C."
  - "\uCC38\uACE0\uB85C \uC7AC\uB8CC\uB791 \uACE8\uB4DC\uAC00 \uB4DC\uB2C8 \uC54C\uC544\uB46C.\n\uB2E8\uACC4\uAC00
    \uB192\uC544\uC9C8\uC218\uB85D \uB354 \uB9CE\uC774 \uB4E0\uB2E4\uACE0 \uD558\uB124."
  - "\uB610\uD55C,\n\uBB34\uC870\uAC74 \uAC15\uD654\uAC00 \uB418\uB294 \uAC74 \uC544\uB2C8\uB2C8
    \uC798 \uC0DD\uAC01\uD574\uC11C \uC9C4\uD589\uD558\uAC8C."
