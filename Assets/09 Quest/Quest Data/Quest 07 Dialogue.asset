  m_Script: {fileID: 11500000, guid: 08cda962ed693fe4cb309255159f3173, type: 3}
  m_Name: Quest 07 Dialogue
  m_EditorClassIdentifier: 
  dialogueId: Quest 07 Dialogue
  lines:
  - "\uD55C \uAC00\uC9C0 \uD301\uC744 \uB354 \uC54C\uB824\uC8FC\uACA0\uB124."
  - "\uAC15\uB825\uD55C \uBAAC\uC2A4\uD130\uB4E4\uC744 \uC7A1\uC73C\uB824\uBA74\n\uC790\uB124\uB3C4
    \uAC15\uD574\uC838\uC57C \uD55C\uB2E4\uB124."
  - "\uC774\uBBF8 \uC5C5\uADF8\uB808\uC774\uB4DC\uB294 \uD574\uBD24\uC9C0?\n\uC774\uBC88\uC5D4
    \uC7A5\uBE44\uC5D0 \uAD00\uD574 \uC54C\uB824\uC8FC\uACA0\uB124."
  - "\uC7A5\uBE44\uB294 \uCD1D \uBB34\uAE30, \uAC11\uC637, \uBC29\uD328, \uC2E0\uBC1C\uB85C
    \uB098\uB258\uB124.\n\uAC01 \uC7A5\uBE44\uB9C8\uB2E4 \uB2A5\uB825\uCE58\uAC00
    \uB2E4\uB974\uB2C8 \uC54C\uACE0 \uC788\uC73C\uBA74 \uB418\uB124."
  - "\uC774\uC81C \uC5B4\uB5BB\uAC8C \uC5BB\uB294\uC9C0\uAC00 \uC911\uC694\uD558\uC9C0."
  - "\uC0C1\uC810\uC5D0\uC11C \uBCF4\uC558\uB294\uC9C4 \uBAA8\uB974\uACA0\uB294\uB370.\n\uC0C1\uC810\uC5D0\uC11C\uB3C4
    \uD310\uB9E4\uB97C \uD558\uB124.\n\uADFC\uB370 \uAC00\uACA9\uC774 \uC880 \uBE44\uC2F8\uC11C
    \uC798 \uC0DD\uAC01\uD574\uC11C \uAD6C\uB9E4\uD558\uAC8C.."
  - "\uB610 \uB2E4\uB978 \uBC29\uBC95\uC73C\uB85C\uB294\n\uBAAC\uC2A4\uD130\uB97C
    \uCC98\uCE58\uD558\uBA74 \uB0AE\uC740 \uD655\uB960\uB85C \uC5BB\uC744 \uC218
    \uC788\uB2E4\uB124."
  - "\uC77C\uB2E8 \uB098\uBB34 \uAC80\uC744 \uD68D\uB4DD\uD574 \uCC29\uC6A9\uD574
    \uBCF4\uACA0\uB098?"
  - "\uD589\uC6B4\uC744 \uBE44\uB124.."
