  m_Name: Quest 04 Dialogue
  m_EditorClassIdentifier: 
  dialogueId: Quest 04 Dialogue
  lines:
  - "\uC2DC\uAC04 \uAD1C\uCC2E\uC73C\uBA74 \uB098 \uC880 \uB3C4\uC640\uC8FC\uACA0\uB098?"
  - "\uC880\uBE44\uB97C \uC8FD\uC774\uBA74 \uC369\uC740 \uC0B4\uC810\uC774 \uB098\uC624\uB294\uB370\n\uADF8\uAC70
    \uC880 \uAC00\uC838\uB2E4\uC904 \uC218 \uC788\uACA0\uB098?"
  - "\uB9CE\uC774\uB294 \uC544\uB2C8\uACE0 50\uAC1C\uB9CC \uAC00\uC838\uB2E4\uC8FC\uAC8C\n\uD655\uC778\uD560\uAC8C
    \uC788\uC5B4\uC11C \uADF8\uB7EC\uB124."
  - "\uCC38, \uBE90\uC5B4\uAC00\uC9C0\uB294 \uC54A\uB294\uB370\uB3C4\n\uAE08\uBC29
    \uBCF4\uACE0 \uB2E4\uC2DC \uB3CC\uB824\uC904\uAC8C."
  - "\uBD80\uD0C1 \uC880 \uD558\uACA0\uB124."
