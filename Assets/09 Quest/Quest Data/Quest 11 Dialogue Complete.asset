  m_Script: {fileID: 11500000, guid: 08cda962ed693fe4cb309255159f3173, type: 3}
  m_Name: Quest 11 Dialogue Complete
  m_EditorClassIdentifier: 
  dialogueId: Quest 11 Dialogue Complete
  lines:
  - "\uACE0\uC0DD\uD588\uB2E4\uB124 \uC815\uB9D0\uB85C."
  - "\uBCF4\uC0C1\uC744 \uC8FC\uACA0\uB124..\n\uAE30\uB300\uD574\uB3C4 \uC88B\uC744\uAC70\uC57C."
  - "\uBA3C\uC800 15,000\uACE8\uB4DC\n\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC774 \uCC59\uACA8\uC92C\uB2E4\uB124."
  - "\uB610 \uD55C \uAC00\uC9C0\n\uC774\uAC74 \uB0B4\uAC00 \uB530\uB85C \uC8FC\uB294\uAC78\uC138."
  - "\uBC14\uB85C \uC740 \uAC80 \uC77C\uC138.\n\uB098\uBB34 \uAC80\uC774\uB791 \uCC28\uC6D0\uC774
    \uB2E4\uB97C \uD14C\uC9C0."
  - "\uD639\uC2DC \uC774\uBBF8 \uD68D\uB4DD\uD588\uB294\uAC00?\n\uADF8\uB7FC \uC544\uC27D\uAC8C
    \uB410\uB124. \uD5C8\uD5C8"
  - "\uADF8\uB798\uB3C4..\n\uD310\uB9E4\uD558\uBA74 \uB3C8\uC774 \uC880 \uB420 \uD14C\uB2C8...."
  - "\uC544\uBB34\uD2BC, \uACE0\uB9D9\uB124.\n\uB610 \uCC3E\uC544\uC624\uAC8C\uB098."
