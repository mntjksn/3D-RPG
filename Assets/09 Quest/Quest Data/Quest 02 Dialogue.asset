  m_Script: {fileID: 11500000, guid: 08cda962ed693fe4cb309255159f3173, type: 3}
  m_Name: Quest 02 Dialogue
  m_EditorClassIdentifier: 
  dialogueId: Quest 02 Dialogue
  lines:
  - "\uC654\uB294\uAC00?"
  - "\uB2E4\uB984\uC774 \uC544\uB2C8\uB77C\n\uC804\uD22C\uB97C \uD558\uB2E4 \uBCF4\uBA74
    \uCCB4\uB825\uC774 \uAE08\uBC29 \uBC14\uB2E5\uB0A0\uAC78\uC138."
  - "\uB9CC\uC57D \uC8FD\uAC8C \uB418\uBA74\n\uC18C\uC9C0\uD55C \uACE8\uB4DC\uC5D0
    \uC77C\uBD80\uAC00 \uC0AC\uB77C\uC9C0\uB2C8 \uC8FC\uC758\uD574\uC57C \uD560\uAC78\uC138."
  - "\uC624\uB978\uD3B8\uC5D0 \uC7A1\uB2E4\uD55C \uBB3C\uAC74\uC744 \uD30C\uB294
    \uC0AC\uB78C\uC774 \uC788\uB124.\n\uCE5C\uD558\uAC8C \uC9C0\uB0B4\uBA74 \uB3C4\uC6C0\uC774
    \uB420 \uAC70\uC57C."
  - "\uADF8 \uC0AC\uB78C\uD55C\uD14C \uAC00\uC11C \uD558\uAE09 \uD3EC\uC158 5\uAC1C\uB97C
    \uAD6C\uB9E4\uD574 \uBCF4\uAC8C\n\uC88B\uC740 \uD3EC\uC158\uC740 \uAC12\uC774
    \uBE44\uC2F8\uB2C8 \uC2E0\uC911\uD788 \uAD6C\uB9E4\uD558\uAC8C.."
  - "\uAD6C\uB9E4\uD558\uACE0 \uB098\uB97C \uB2E4\uC2DC \uCC3E\uC544\uC624\uAC8C."
